---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import { about } from "../config/about";
import { site } from "../config/site";
---
<BaseLayout title="About Us" description="About NextGen Infra: our story, vision and mission.">
  <PageHero eyebrow="About Us" title="Infrastructure you can count on" />
  <section class="section">
    <div class="container-x grid items-start gap-14 lg:grid-cols-2">
      <div data-reveal>
        <p class="eyebrow">Our Story</p>
        <h2 class="mt-3 text-4xl text-navy-900">Who we are</h2>
        {about.story.map((t) => <p class="mt-5 leading-relaxed text-ink/75">{t}</p>)}
      </div>
      <div class="overflow-hidden rounded-2xl"><img src="/images/nextgen-farms-cover.webp" alt="NextGen Farms" data-clip loading="lazy" class="w-full object-cover" /></div>
    </div>
  </section>

  <section class="bg-navy-900 py-20">
    <div class="container-x grid gap-8 md:grid-cols-2">
      <div class="rounded-2xl border border-white/10 p-8" data-reveal>
        <p class="eyebrow">Vision</p><p class="mt-4 font-serif text-2xl leading-snug text-white">{about.vision}</p>
      </div>
      <div class="rounded-2xl border border-white/10 p-8" data-reveal data-delay="0.1">
        <p class="eyebrow">Mission</p><p class="mt-4 font-serif text-2xl leading-snug text-white">{about.mission}</p>
      </div>
    </div>
    {about.values.length > 0 && (
      <div class="container-x mt-10 flex flex-wrap justify-center gap-3">
        {about.values.map((v) => <span class="rounded-full border border-gold-500/50 px-5 py-2 text-sm text-gold-400">{v}</span>)}
      </div>
    )}
  </section>

  {about.leadership.length > 0 && (
    <section class="section">
      <div class="container-x">
        <p class="eyebrow text-center">Leadership</p>
        <div class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
          {about.leadership.map((l) => (
            <div class="text-center" data-reveal>
              {l.photo && <img src={l.photo} alt={l.name} loading="lazy" class="mx-auto h-40 w-40 rounded-full object-cover" />}
              <p class="mt-4 font-serif text-xl text-navy-900">{l.name}</p>
              <p class="text-sm text-gold-500">{l.role}</p>
              {l.bio && <p class="mt-2 text-sm text-ink/70">{l.bio}</p>}
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  {about.certifications.length > 0 && (
    <section class="section bg-white">
      <div class="container-x">
        <p class="eyebrow text-center">Certifications</p>
        <div class="mt-10 grid gap-6 md:grid-cols-3">
          {about.certifications.map((c) => (
            <div class="rounded-2xl border border-navy-900/10 p-6 text-center" data-reveal>
              <p class="font-serif text-xl text-navy-900">{c.label}</p>{c.detail && <p class="mt-2 text-sm text-ink/70">{c.detail}</p>}
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  {about.timeline.length > 0 && (
    <section class="section">
      <div class="container-x max-w-3xl">
        <p class="eyebrow text-center">Our Journey</p>
        <ol class="mt-10 space-y-6 border-l border-gold-500/50 pl-6">
          {about.timeline.map((t) => (
            <li data-reveal><p class="font-serif text-2xl text-gold-500">{t.year}</p><p class="text-ink/75">{t.text}</p></li>
          ))}
        </ol>
      </div>
    </section>
  )}

  <section class="bg-navy-950 py-20 text-center">
    <div class="container-x" data-reveal>
      <h2 class="text-4xl text-white">Visit {site.name}</h2>
      <a href="/contact" class="btn btn-gold mt-8">Contact Us</a>
    </div>
  </section>
</BaseLayout>
