---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Lightbox from "../../components/Lightbox.astro";
import EnquiryForm from "../../components/EnquiryForm.astro";
import { site, whatsappUrl } from "../../config/site";
import { projects, statusLabel, statusBadge, mapsLink, mapsEmbed, type Project } from "../../lib/projects";

export function getStaticPaths() {
  return projects.map((p) => ({ params: { slug: p.slug }, props: { project: p } }));
}
const { project: p } = Astro.props as { project: Project };
const enquireUrl = "#enquire";
const wa = whatsappUrl(`Hello NextGen Infra, I am interested in ${p.title} (${p.city}). Please share details.`);
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "RealEstateListing",
  name: p.title,
  description: p.shortDescription,
  url: new URL(`/projects/${p.slug}`, Astro.site).href,
  image: new URL(p.cover, Astro.site).href,
  address: { "@type": "PostalAddress", streetAddress: p.address, addressLocality: p.city, addressCountry: "IN" },
  provider: { "@type": "Organization", name: site.name, url: site.url },
};
const facts = [
  { label: "Price", value: p.priceRange },
  { label: "Type", value: p.type },
  { label: "Total Area", value: p.totalArea },
  { label: "Plots / Units", value: p.totalUnits },
  { label: "Possession", value: p.possessionDate },
  { label: "RERA No.", value: p.reraNumber },
].filter((f) => f.value);
---
<BaseLayout title={p.title} description={p.shortDescription} floating={false} jsonLd={jsonLd}>
  <!-- HERO -->
  <section class="relative flex min-h-[70vh] items-end overflow-hidden bg-navy-950">
    <img src={p.cover} alt={p.title} class="absolute inset-0 h-full w-full object-cover" fetchpriority="high" />
    <div class="absolute inset-0 bg-gradient-to-t from-navy-950 via-navy-950/50 to-navy-950/40"></div>
    <div class="container-x relative pb-14 pt-40">
      <a href="/projects" class="text-sm text-white/70 hover:text-gold-400">← All projects</a>
      <div class="mt-4 flex items-center gap-3" data-reveal>
        <span class={`rounded-full px-3 py-1 text-xs font-semibold ${statusBadge[p.status]}`}>{statusLabel[p.status]}</span>
        <span class="text-sm uppercase tracking-widest text-gold-400">{p.city}</span>
      </div>
      <h1 class="mt-3 text-5xl text-white sm:text-7xl" data-reveal data-delay="0.1">{p.title}</h1>
      <p class="mt-4 max-w-2xl text-lg text-white/75" data-reveal data-delay="0.2">{p.shortDescription}</p>
    </div>
  </section>

  <!-- QUICK FACTS -->
  <section class="bg-navy-900">
    <div class="container-x grid grid-cols-2 gap-6 py-8 md:grid-cols-4">
      {facts.map((f) => (
        <div>
          <p class="text-xs uppercase tracking-widest text-white/50">{f.label}</p>
          <p class="mt-1 font-serif text-xl text-gold-400">{f.value}</p>
        </div>
      ))}
    </div>
  </section>

  <div class="container-x grid gap-12 pb-28 pt-16 lg:grid-cols-[1fr_340px] lg:pb-16">
    <div class="space-y-16">
      <!-- OVERVIEW -->
      <section data-reveal>
        <p class="eyebrow">Overview</p>
        <h2 class="mt-3 text-3xl text-navy-900 sm:text-4xl">About {p.title}</h2>
        {(p.description ?? [p.shortDescription]).map((t) => <p class="mt-5 leading-relaxed text-ink/75">{t}</p>)}
        {p.amenities?.length ? (
          <div class="mt-8 flex flex-wrap gap-3">
            {p.amenities.map((a) => <span class="rounded-full border border-gold-500/50 bg-white px-4 py-2 text-sm text-navy-900">{a}</span>)}
          </div>
        ) : null}
      </section>

      <!-- PLOT SIZES -->
      {p.plotSizes?.length ? (
        <section data-reveal>
          <p class="eyebrow">Plot sizes</p>
          <h2 class="mt-3 text-3xl text-navy-900 sm:text-4xl">Sizes &amp; areas</h2>
          <div class="mt-8 overflow-x-auto rounded-2xl bg-white ring-1 ring-black/5">
            <table class="w-full min-w-[420px] text-left text-sm">
              <thead class="bg-navy-950 text-white"><tr><th class="px-5 py-3 font-semibold">Plot</th><th class="px-5 py-3 font-semibold">Dimensions</th><th class="px-5 py-3 font-semibold">Area</th></tr></thead>
              <tbody class="divide-y divide-navy-900/10">
                {p.plotSizes.map((r) => <tr><td class="px-5 py-3 font-semibold text-navy-900">{r.plots}</td><td class="px-5 py-3">{r.size}</td><td class="px-5 py-3 text-gold-500 font-semibold">{r.area}</td></tr>)}
              </tbody>
            </table>
          </div>
          <p class="mt-3 text-xs text-ink/50">As per the current site plan. Some plots are irregular in shape; please confirm exact dimensions with our team.</p>
        </section>
      ) : null}

      <!-- GALLERY -->
      {p.gallery?.length ? (
        <section>
          <p class="eyebrow" data-reveal>Gallery</p>
          <h2 class="mt-3 text-3xl text-navy-900 sm:text-4xl" data-reveal>Project photos</h2>
          <div class="mt-8 grid grid-cols-2 gap-3 md:grid-cols-3">
            {p.gallery.map((src, i) => (
              <button type="button" data-lightbox="gallery" data-src={src} data-caption={`${p.title} – photo ${i + 1}`}
                      class:list={["group overflow-hidden rounded-xl", i === 0 && "col-span-2 row-span-2"]}>
                <img src={src} alt={`${p.title} photo ${i + 1}`} loading="lazy" width="800" height="500"
                     class="h-full w-full object-cover transition duration-700 group-hover:scale-110" />
              </button>
            ))}
          </div>
        </section>
      ) : null}

      <!-- VIDEO -->
      {p.videoUrl ? (
        <section data-reveal>
          <p class="eyebrow">Video</p>
          <h2 class="mt-3 text-3xl text-navy-900 sm:text-4xl">Project walkthrough</h2>
          <div class="mt-8 aspect-video overflow-hidden rounded-2xl">
            <iframe src={p.videoUrl} title={`${p.title} video`} loading="lazy" class="h-full w-full" allowfullscreen></iframe>
          </div>
        </section>
      ) : null}

      <!-- FLOOR PLANS -->
      {p.floorPlans?.length ? (
        <section>
          <p class="eyebrow" data-reveal>Plans</p>
          <h2 class="mt-3 text-3xl text-navy-900 sm:text-4xl" data-reveal>Floor &amp; site plans</h2>
          <div class="mt-8 grid gap-4 sm:grid-cols-2">
            {p.floorPlans.map((f) => (
              <button type="button" data-lightbox="plans" data-src={f.image} data-caption={f.label}
                      class="group overflow-hidden rounded-xl bg-white text-left ring-1 ring-black/5">
                <img src={f.image} alt={f.label} loading="lazy" width="800" height="500" class="aspect-[4/3] w-full object-cover transition duration-500 group-hover:scale-105" />
                <p class="p-4 text-sm font-semibold text-navy-900">{f.label}</p>
              </button>
            ))}
          </div>
        </section>
      ) : null}

      <!-- LOCATION -->
      <section>
        <p class="eyebrow" data-reveal>Location</p>
        <h2 class="mt-3 text-3xl text-navy-900 sm:text-4xl" data-reveal>Find the project</h2>
        {p.address && <p class="mt-4 text-ink/75" data-reveal>{p.address}</p>}
        <div class="mt-6 overflow-hidden rounded-2xl ring-1 ring-black/10" data-reveal>
          <iframe src={mapsEmbed(p)} title={`${p.title} location map`} loading="lazy" referrerpolicy="no-referrer-when-downgrade"
                  class="h-[360px] w-full border-0"></iframe>
        </div>
        <a href={mapsLink(p)} target="_blank" rel="noopener" class="btn btn-gold mt-6">Open in Google Maps</a>
      </section>

      <!-- DOCUMENTS -->
      {p.documents?.length ? (
        <section data-reveal>
          <p class="eyebrow">Documents</p>
          <h2 class="mt-3 text-3xl text-navy-900 sm:text-4xl">Download documents</h2>
          <ul class="mt-8 divide-y divide-navy-900/10 rounded-2xl bg-white ring-1 ring-black/5">
            {p.documents.map((d) => (
              <li>
                <a href={d.file} target="_blank" rel="noopener" download
                   class="flex items-center justify-between px-6 py-4 text-navy-900 transition hover:text-gold-500">
                  <span class="font-semibold">{d.label}</span>
                  <span class="text-sm text-gold-500">PDF ↓</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ) : null}

      <!-- ENQUIRY -->
      <section id="enquire" class="scroll-mt-28">
        <p class="eyebrow">Enquire</p>
        <h2 class="mb-8 mt-3 text-3xl text-navy-900 sm:text-4xl">Interested in {p.title}?</h2>
        <EnquiryForm project={p.slug} />
      </section>
    </div>

    <!-- SIDEBAR (desktop sticky enquiry card) -->
    <aside class="hidden lg:block">
      <div class="sticky top-28 rounded-2xl bg-navy-950 p-8 text-white shadow-xl">
        <p class="eyebrow">Interested?</p>
        <p class="mt-3 font-serif text-2xl">{p.title}</p>
        <p class="mt-1 text-gold-400">{p.priceRange}</p>
        <a href={enquireUrl} class="btn btn-gold mt-6 w-full">Enquire Now</a>
        <a href={wa} target="_blank" rel="noopener" class="btn btn-outline mt-3 w-full">WhatsApp Us</a>
        <a href={`tel:+${site.phoneRaw}`} class="mt-5 block text-center text-sm text-white/70 hover:text-gold-400">Call {site.phone}</a>
      </div>
    </aside>
  </div>

  <!-- MOBILE STICKY BAR -->
  <div class="fixed inset-x-0 bottom-0 z-40 flex gap-2 bg-navy-950/95 p-3 backdrop-blur lg:hidden">
    <a href={enquireUrl} class="btn btn-gold flex-1 !py-3">Enquire Now</a>
    <a href={wa} target="_blank" rel="noopener" class="btn btn-outline !px-5 !py-3" aria-label="WhatsApp">WhatsApp</a>
    <a href={`tel:+${site.phoneRaw}`} class="btn btn-outline !px-5 !py-3" aria-label="Call">Call</a>
  </div>

  <Lightbox />
</BaseLayout>
