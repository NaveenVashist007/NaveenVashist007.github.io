---
import { site, whatsappUrl } from "../config/site";
---
<!-- Floating WhatsApp + Call buttons (mobile only) -->
<div class="fixed bottom-4 right-4 z-40 flex flex-col gap-3 md:hidden">
  <a href={whatsappUrl()} target="_blank" rel="noopener" aria-label="Chat on WhatsApp"
     class="grid h-12 w-12 place-items-center rounded-full bg-[#25D366] text-white shadow-lg">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 0 0-8.6 15L2 22l5.2-1.4A10 10 0 1 0 12 2zm5.2 14.2c-.2.6-1.3 1.2-1.8 1.2-.5.1-1 .2-3.3-.7-2.8-1.2-4.5-4-4.7-4.2-.1-.2-1.1-1.5-1.1-2.8s.7-2 1-2.3c.2-.3.5-.3.7-.3h.5c.2 0 .4 0 .6.5l.8 2c.1.2.1.4 0 .5l-.4.6-.4.4c-.1.2-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.2 1 2.1 1.3 2.4 1.5.3.1.5.1.6-.1l.9-1.1c.2-.3.4-.2.6-.1l1.9.9c.3.1.5.2.5.3.1.2.1.7-.1 1.3z"/></svg>
  </a>
  <a href={`tel:+${site.phoneRaw}`} aria-label="Call us"
     class="grid h-12 w-12 place-items-center rounded-full bg-gold-500 text-navy-950 shadow-lg">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M6.6 10.8a15 15 0 0 0 6.6 6.6l2.2-2.2a1 1 0 0 1 1-.25 11 11 0 0 0 3.6.6 1 1 0 0 1 1 1V20a1 1 0 0 1-1 1A17 17 0 0 1 3 4a1 1 0 0 1 1-1h3.5a1 1 0 0 1 1 1c0 1.3.2 2.5.6 3.6a1 1 0 0 1-.25 1z"/></svg>
  </a>
</div>
