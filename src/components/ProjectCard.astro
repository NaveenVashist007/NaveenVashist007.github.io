---
import type { Project } from "../lib/projects";
import { statusLabel, statusBadge } from "../lib/projects";
const { project } = Astro.props as { project: Project };
---
<a href={`/projects/${project.slug}`} data-status={project.status} data-city={project.city} data-type={project.type}
   class="group block overflow-hidden rounded-2xl bg-white shadow-sm ring-1 ring-black/5 transition duration-500 hover:-translate-y-1 hover:shadow-xl">
  <div class="relative aspect-[4/3] overflow-hidden">
    <img src={project.cover} alt={project.title} loading="lazy" width="800" height="600"
         class="h-full w-full object-cover transition duration-700 group-hover:scale-110" />
    <span class={`absolute left-4 top-4 rounded-full px-3 py-1 text-xs font-semibold ${statusBadge[project.status]}`}>
      {statusLabel[project.status]}
    </span>
  </div>
  <div class="p-6">
    <p class="text-xs uppercase tracking-widest text-gold-500">{project.type} · {project.city}</p>
    <h3 class="mt-2 text-2xl text-navy-900">{project.title}</h3>
    <p class="mt-3 text-sm leading-relaxed text-ink/70">{project.shortDescription}</p>
    <div class="mt-5 flex items-center justify-between text-sm">
      <span class="font-semibold text-navy-900">{project.priceRange}</span>
      <span class="text-gold-500 transition group-hover:translate-x-1">View details →</span>
    </div>
  </div>
</a>
